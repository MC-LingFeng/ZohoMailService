# Copy only when creating a NEW config. Do not replace an existing encryption key.
APP_MODE=live
APP_PASSWORD=replace-with-a-unique-password-at-least-12-characters
TOKEN_ENCRYPTION_KEY=replace-with-your-existing-or-new-64-hex-character-key

# Browser-facing address, not the internal container name/address.
FRONTEND_URL=http://localhost:3001
ZOHO_REDIRECT_URI=http://localhost:3001/api/auth/zoho/callback

# HOST, PORT, DATA_DIR, WEB_ROOT and DOTENV_CONFIG_PATH are supplied by Compose.
ZOHO_MIN_REQUEST_INTERVAL_MS=2100

# Mailbox Client ID/Client Secret are entered on the binding page and stored in SQLite.
