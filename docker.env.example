# 仅用于新建配置，请保留已有密钥。

# 运行模式（demo 演示，live 真实邮箱）
APP_MODE=live
# 工作区密码（至少 12 个字符）
APP_PASSWORD=replace-with-a-unique-password-at-least-12-characters
# 令牌加密密钥（修改后旧授权失效）
TOKEN_ENCRYPTION_KEY=replace-with-your-existing-or-new-64-hex-character-key

# 网页访问地址
FRONTEND_URL=http://localhost:3001
# 授权回调地址
ZOHO_REDIRECT_URI=http://localhost:3001/api/auth/zoho/callback

# 接口请求间隔（毫秒，至少 2100）
ZOHO_MIN_REQUEST_INTERVAL_MS=2100

# Google Ads（可选，手动刷新 Offer 的美元累计成本）
ADS_MANAGER_ACCOUNT=
# 相对路径以此配置文件所在目录为准，Docker 使用 compose.ads.yaml 挂载
ADS_CREDENTIALS_FILE=./credentials.json
ADS_API_VERSION=v26

# 容器监听地址、端口和数据目录由 Compose 管理。
# 邮箱应用凭据在「邮箱账号」填写。
